{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skills Inventory Preview",
  "version": "0.1.0",
  "identifier": "dev.skillsmanager.inventorypreview",
  "build": {
    "frontendDist": "inventory-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skills Manager · 只读清单测试",
        "width": 1000,
        "height": 700,
        "minWidth": 680,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
